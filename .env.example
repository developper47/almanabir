# MongoDB Database Connection String
# Replace with your actual MongoDB URI in .env.local (do NOT commit .env.local to git)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/almanabir?retryWrites=true&w=majority

# Secret key used to sign and verify JWT authentication tokens (minimum 32 characters)
JWT_SECRET=replace-this-with-a-secure-random-32-character-secret

# Resend API Key for sending verification emails (optional in development)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

